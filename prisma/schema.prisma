// Barrera Wallplate ERP — Complete Database Schema
// PostgreSQL + Prisma 7

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════

enum UserRole {
  ADMIN
  VENDEDOR
  USUARIO
}

enum BarcodeType {
  EAN13
  CODE128
  QR
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
  TRANSFER
}

enum ClientType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum ConsignmentStatus {
  PENDING
  ACTIVE
  PARTIAL_RETURN
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

// ═══════════════════════════════════════
// MODELS
// ═══════════════════════════════════════

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole @default(USUARIO)
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  phone         String?
  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  sales              Sale[]
  consignments       Consignment[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  syncQueue          SyncQueue[]

  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  category    String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  sku         String   @unique
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  variants ProductVariant[]
  barcodes Barcode[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  name          String
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  minStockAlert Int      @default(5) @map("min_stock_alert")
  imageUrl      String?  @map("image_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes           Barcode[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  consignmentItems   ConsignmentItem[]

  @@index([productId])
  @@index([stockQuantity])
  @@map("product_variants")
}

model Barcode {
  id        String      @id @default(uuid())
  productId String      @map("product_id")
  variantId String?     @map("variant_id")
  code      String      @unique
  type      BarcodeType @default(CODE128)
  imageUrl  String?     @map("image_url")
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([code])
  @@map("barcodes")
}

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String?
  state       String?
  managerName String?  @map("manager_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  consignments       Consignment[]

  @@map("warehouses")
}

model InventoryMovement {
  id          String       @id @default(uuid())
  variantId   String       @map("variant_id")
  warehouseId String       @map("warehouse_id")
  userId      String       @map("user_id")
  type        MovementType
  quantity    Int
  reason      String?
  referenceId String?      @map("reference_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relations
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@index([variantId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Client {
  id          String     @id @default(uuid())
  companyName String?    @map("company_name")
  contactName String     @map("contact_name")
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  taxId       String?    @map("tax_id")
  type        ClientType @default(RETAIL)
  creditLimit Decimal?   @map("credit_limit") @db.Decimal(10, 2)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  sales        Sale[]
  consignments Consignment[]
  invoices     Invoice[]

  @@index([type])
  @@index([isActive])
  @@map("clients")
}

model Sale {
  id            String        @id @default(uuid())
  saleNumber    String        @unique @map("sale_number")
  clientId      String?       @map("client_id")
  userId        String        @map("user_id")
  warehouseId   String?       @map("warehouse_id")
  status        SaleStatus    @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  notes         String?       @db.Text
  saleDate      DateTime      @default(now()) @map("sale_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  client    Client?    @relation(fields: [clientId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  items     SaleItem[]
  invoice   Invoice?

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  variantId String  @map("variant_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  // Relations
  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model Consignment {
  id                 String            @id @default(uuid())
  consignmentNumber  String            @unique @map("consignment_number")
  clientId           String            @map("client_id")
  userId             String            @map("user_id")
  warehouseId        String?           @map("warehouse_id")
  status             ConsignmentStatus @default(PENDING)
  shipDate           DateTime?         @map("ship_date")
  dueDate            DateTime?         @map("due_date")
  notes              String?           @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relations
  client    Client           @relation(fields: [clientId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id])
  items     ConsignmentItem[]

  @@index([clientId])
  @@index([userId])
  @@index([status])
  @@map("consignments")
}

model ConsignmentItem {
  id               String  @id @default(uuid())
  consignmentId    String  @map("consignment_id")
  variantId        String  @map("variant_id")
  quantitySent     Int     @map("quantity_sent")
  quantitySold     Int     @default(0) @map("quantity_sold")
  quantityReturned Int     @default(0) @map("quantity_returned")
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)

  // Relations
  consignment Consignment    @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])

  @@index([consignmentId])
  @@map("consignment_items")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  saleId        String?       @unique @map("sale_id")
  clientId      String        @map("client_id")
  userId        String        @map("user_id")
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @map("tax_amount") @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  issueDate     DateTime      @default(now()) @map("issue_date")
  dueDate       DateTime?     @map("due_date")
  paidDate      DateTime?     @map("paid_date")
  pdfUrl        String?       @map("pdf_url")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  sale   Sale?  @relation(fields: [saleId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model SyncQueue {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  entityType String     @map("entity_type")
  entityId   String?    @map("entity_id")
  operation  String
  payload    Json
  status     SyncStatus @default(PENDING)
  retryCount Int        @default(0) @map("retry_count")
  createdAt  DateTime   @default(now()) @map("created_at")
  syncedAt   DateTime?  @map("synced_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("sync_queue")
}
